# ============================================================================
# 换行符规范
# ----------------------------------------------------------------------------
# 这个工程要在 Windows / macOS / Linux 上都能直接跑。
# 不统一的话，Windows 上 clone 下来看到满屏「整个文件都被改了」，实际上一个字没动。
# ============================================================================

# 默认：检出时用各平台习惯的换行，存进仓库一律 LF
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则某些 cmd 环境下会解析失败
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper 脚本必须是 LF，否则 Linux/macOS 上会报 `bad interpreter`
gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制：不要做任何换行转换，也不要试图 diff
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.db binary
*.ttf binary
*.otf binary

# 生成的代码不参与语言统计（免得「Kotlin 占比」被虚高）
build/ linguist-generated=true
